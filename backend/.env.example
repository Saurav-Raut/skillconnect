# SkillConnect Environment Configuration Example
# Copy this file to .env and fill in your actual environment secrets.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillconnect
JWT_SECRET=replace_with_a_secure_random_hex_key

# Optional third-party integrations (system runs in mock fallback mode if empty)
CLOUDINARY_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
